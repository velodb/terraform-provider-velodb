region      = "us-east-1"
bucket_name = "replace-with-your-existing-bucket-name"
name_prefix = "production"

vpc_id            = "vpc-0123456789abcdef0"
security_group_id = "sg-0123456789abcdef0"
endpoint_id       = "vpce-0123456789abcdef0"

subnet_ids_by_zone = {
  us-east-1a = "subnet-0123456789abcdef0"
  us-east-1b = "subnet-1123456789abcdef0"
  us-east-1d = "subnet-2123456789abcdef0"
}

data_credential_arn       = "arn:aws:iam::123456789012:instance-profile/velodb-data-access"
deployment_credential_arn = "arn:aws:iam::123456789012:role/velodb-deployment"

additional_clusters = {}
