region                 = "us-east-1"
bucket_name            = "replace-with-a-globally-unique-bucket-name"
name_prefix            = "production"
vpc_cidr               = "10.57.0.0/16"
zones                  = ["us-east-1a", "us-east-1b", "us-east-1c"]
# Defaults to [vpc_cidr]. Set [] to disable direct client access.
# warehouse_client_cidrs = ["10.57.0.0/16"]

# Optional: override the per-AZ subnet CIDRs. Zones left out fall back to the
# derived /20 block. Use this for non-standard zones, to align with an external
# network plan, or to pin an existing deployment's CIDRs before upgrading.
# subnet_cidrs = {
#   "us-east-1a" = "10.57.16.0/20"
#   "us-east-1b" = "10.57.32.0/20"
#   "us-east-1c" = "10.57.48.0/20"
# }

additional_clusters = {}

tags = {
  environment = "production"
  managed-by  = "terraform"
}

# Creation accepts "26.1" (latest patch) or "26.1.1". Set "26.1.2" to upgrade later.
# core_version = "26.1"

# Public network access policy. Changes update the existing warehouse in place.
# Leave unset for the API default; null later stops management without a reset.
# public_access_policy = {
#   policy = "ALLOWLIST_ONLY"
#   rules = [
#     { cidr = "203.0.113.0/24", description = "office" },
#   ]
# }

# Transparent Data Encryption (TDE) key. Either let the module create a new AWS
# KMS key or bring an existing one — the two options are mutually exclusive.
# create_tde_encryption_key = true
# tde_kms_key_arn           = "arn:aws:kms:us-east-1:111122223333:key/00000000-0000-0000-0000-000000000000"

# EBS encryption key. Either let the module create a new AWS KMS key or bring an
# existing one — the two options are mutually exclusive.
# create_ebs_encryption_key = true
# ebs_kms_key_arn           = "arn:aws:kms:us-east-1:111122223333:key/00000000-0000-0000-0000-000000000000"

# Initial cluster cache storage (choose before creation):
#   cache_type = 0 -> EBS: set node_cache to the cache GB per node.
#   cache_type = 1 -> Local NVMe: OMIT node_cache; capacity is fixed by the package.
# For either option, set node_vcpu and node_count; ratio selects RAM GB per vCPU.
# The commented example below selects EBS. For NVMe, change cache_type to 1
# and leave node_cache unset. Cache type cannot be changed after creation.
# Leave all capacity fields unset to retain the legacy default of 4 vCPUs
# and 100 GB of EBS cache.
# cache_type = 0
# ratio      = 4
# node_vcpu  = 4
# node_count = 1
# node_cache = 100

# For a local NVMe initial cluster instead, set cache_type = 1 with ratio,
# node_vcpu and node_count above, and OMIT node_cache. Manager selects its size.
# Never combine node fields with legacy compute_vcpu/cache_gb.

# Additional clusters can use either capacity family. Replace the existing
# additional_clusters assignment above to try this local NVMe example:
# additional_clusters = {
#   local_worker = {
#     name       = "local_worker"
#     cache_type = 1
#     ratio      = 4
#     node_vcpu  = 4
#     node_count = 1
#   }
# }
